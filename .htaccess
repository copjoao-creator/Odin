# .htaccess da raiz do site (public_html/.htaccess) — Plataforma Odin Focus
#
# Este arquivo pode SUBSTITUIR o public_html/.htaccess do servidor.
# Única exceção: se o arquivo do servidor tiver um bloco "# php -- BEGIN cPanel-generated handler"
# (escolha da versão do PHP feita pelo cPanel), copie esse bloco para o fim deste arquivo antes de enviar.

# ---------- Cache ----------
# Páginas, estilos e scripts: o navegador sempre confere se há versão nova (responde rápido quando
# não mudou). Sem isso, quem já tinha aberto o site continua vendo as páginas antigas.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ---------- Endereço único: https://www.odinfocus.com.br ----------
  # Um endereço só evita carrinho e login "sumindo" ao trocar entre com e sem www, e o HTTPS é
  # exigido para receber pagamentos. A pasta .well-known fica de fora (renovação do certificado).
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTP_HOST} ^odinfocus\.com\.br$ [NC]
  RewriteRule ^(.*)$ https://www.odinfocus.com.br/$1 [R=301,L]

  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # ---------- Plataforma: endereços das lojas ----------
  # Cada loja fica em odinfocus.com.br/{endereço}/ e usa os arquivos da pasta loja/ (o mesmo sistema
  # para todas). O sistema descobre a loja pelo endereço. A loja original continua em /loja/.

  # "Entrar" (login único da plataforma).
  RewriteRule ^entrar/?$ /loja/entrar.html [R=302,L]

  # /{loja} sem barra no fim -> /{loja}/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([a-z0-9][a-z0-9-]{1,38}[a-z0-9])$ /$1/ [R=301,L]

  # Imagens enviadas no painel de cada loja: loja/uploads/lojas/{loja}/...
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([a-z0-9][a-z0-9-]{1,38}[a-z0-9])/uploads/(.*)$ loja/uploads/lojas/$1/$2 [L]

  # Páginas, estilos, scripts e API de cada loja: os arquivos da pasta loja/.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([a-z0-9][a-z0-9-]{1,38}[a-z0-9])/(.*)$ loja/$2 [L,QSA]
</IfModule>
