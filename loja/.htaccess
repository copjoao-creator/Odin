# Loja Odin Focus

# Páginas, JS e CSS: o navegador sempre confere se há versão nova (responde rápido quando não mudou).
# Sem isso, depois de enviar arquivos novos o navegador pode continuar mostrando os antigos.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Esconde pastas do git (.git) caso sejam enviadas por engano para a hospedagem.
RedirectMatch 404 /\.git

# Protege o arquivo com a senha do banco de dados e os arquivos de documentação/SQL.
<FilesMatch "^(config\.php|config\.exemplo\.php|.*\.md|.*\.sql)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
